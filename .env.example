# LiveKit Inference — latency-tuned
LK_STT_MODEL=deepgram/flux-general
LK_LLM_MODEL=google/gemma-4-31b-it
LK_TTS_MODEL=cartesia/sonic-turbo
LK_TTS_VOICE=638efaaa-4d0c-442e-b701-3fae16aad012
LK_TTS_SPEED=normal

# Sales / outreach
COMPANY_NAME=Acme Outreach
COMPANY_PITCH=We help businesses grow with practical tools and support.

# Cloud worker tuning
NUM_IDLE_PROCESSES=1
